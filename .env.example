# ---- Required: Claude (all agents) ----
ANTHROPIC_API_KEY=

# ---- Required for posting: X API, OAuth 1.0a *user context* for @0xYYcn ----
# developer.x.com -> Project -> App -> "User authentication settings": Read and write
# then "Keys and tokens": regenerate Access Token & Secret AFTER enabling write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Bearer token (app-only) - used for reading watch-list timelines / metrics
X_BEARER_TOKEN=

# ---- Recommended: Telegram approval inbox ----
# Create a bot with @BotFather -> token. Message your bot once, then run `xbot telegram-setup`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional ----
GITHUB_TOKEN=            # raises GitHub API rate limit for release tracking
XBOT_STATE_DIR=state     # where the SQLite DB lives
